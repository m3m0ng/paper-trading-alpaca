# Alpaca paper credentials. Never commit your real .env file.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Safety: execution is disabled unless this is exactly true.
BOT_TRADING_ENABLED=false
# A hard cap on capital this bot may manage. Agreed initial V1 value: 5000
# ($5,000 managed paper allocation). Configuration only — never hard-coded in code.
BOT_MAX_MANAGED_EQUITY=0
# Preserve this percentage of broker-reported cash for price movement and order rounding.
BOT_CASH_BUFFER_PERCENT=2
# Volatility is a risk cap, not a forecast. 0.10 means 10% annualized realized volatility.
BOT_TARGET_ANNUAL_VOLATILITY=0.10

# V1 is deliberately deterministic. AI research is reserved for a later, budgeted module.
BOT_AI_ENABLED=false
BOT_AI_MONTHLY_BUDGET_USD=0
